# คัดลอกเป็น deploy.env แล้วแก้ค่า scripts/*.sh จะอ่านไฟล์นี้ให้เอง
# deploy.env ไม่ถูก commit ค่าที่ส่งทาง command line มีผลก่อนค่าในไฟล์นี้

PROJECT_ID=
REGION=asia-southeast1
# ชื่อ Cloud Run service และคำนำหน้าชื่อทรัพยากรอื่น
SERVICE_NAME=nida-bot

# เว้นว่าง = สร้าง Gemini API key ใหม่ใน project
GEMINI_KEY=
GEMINI_MODEL=gemini-3.5-flash
# model ที่ใช้ประเมินผลการตอบของผู้ใช้เมื่อปิดเคส
GEMINI_EVAL_MODEL=gemini-3.5-flash

# ขนาดและการ scale ของ Cloud Run ค่าตั้งต้นเน้นประหยัด: ไม่มีผู้ใช้ = ไม่มีค่า CPU
CPU=1
MEMORY=512Mi
# จำนวน gunicorn worker ต่อ instance (แอปเป็น async หนึ่ง worker รับได้หลาย request)
WORKERS=1
CONCURRENCY=40
# 1 = ไม่ต้องรอ cold start แต่มีค่าใช้จ่ายรายเดือนคงที่
MIN_INSTANCES=0
MAX_INSTANCES=2
REQUEST_TIMEOUT=300

# true = เปิดหน้าเว็บได้จากทุกที่ (ยังต้อง login ด้วยบัญชีของแอป)
PUBLIC=true
